# Template for .env. Run `python scripts/setup_env.py` to copy this file and
# fill in a generated DJANGO_SECRET_KEY. .env is gitignored and never committed.

# =============================================================================
# Basic -- the lines you edit
# =============================================================================

# Required; the app refuses to boot without it. `python scripts/setup_env.py`
# generates one into this line.
DJANGO_SECRET_KEY=

# Which LLM adapter services/llm builds: groq | claude | chatgpt | deepseek. Blank means groq.
LLM_PROVIDER=

# groq: free tier, no credit card. Get a key at https://console.groq.com
GROQ_API_KEY=

# claude: the anthropic SDK reads ANTHROPIC_API_KEY; CLAUDE_API_KEY is an alias.
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=

# chatgpt
OPENAI_API_KEY=

# deepseek
DEEPSEEK_API_KEY=

# Comma-separated addresses allowed to sign in. There is no signup flow.
LOGIN_ALLOWED_EMAILS=

# JSON-RPC URL of the EVM node `manage.py ingest_blocks` reads new blocks and
# receipts from, e.g. https://eth-mainnet.example.com/v2/<key>. It must
# serve eth_getBlockReceipts.
EVM_RPC_URL=

# =============================================================================
# Advanced -- defaults are fine
# =============================================================================

# Django debug pages and static serving. Blank means off; local dev only.
DJANGO_DEBUG=
# Comma-separated hostnames. Required (non-empty) when DJANGO_DEBUG is not True.
DJANGO_ALLOWED_HOSTS=
# Comma-separated origins with scheme, for TLS terminating in front of the app.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Database URL, e.g. postgres://user:pass@host:5432/db. Blank uses ./db.sqlite3.
DATABASE_URL=
# Log level for the project.app logger; the console sign-in link is logged at INFO.
DJANGO_LOG_LEVEL=INFO
# Model id for the chosen provider. Blank uses that adapter's own default.
LLM_MODEL=
# console prints the sign-in link to the server log; email uses Django's email backend.
LOGIN_LINK_DELIVERY=console
# How long a sign-in link stays valid, in seconds.
LOGIN_TOKEN_TTL_SECONDS=900
# Origin the sign-in link points at; the link opens its /auth/consume page.
LOGIN_LINK_BASE_URL=http://127.0.0.1:8000
# Link requests allowed per address.
LOGIN_RATE_LIMIT_EMAIL=5/hour
# Link requests allowed per client IP.
LOGIN_RATE_LIMIT_IP=20/hour
# Seconds a client waits before offering to send another link (resend_after).
LOGIN_RESEND_COOLDOWN_SECONDS=30
# Outgoing email, used only when LOGIN_LINK_DELIVERY=email. Defaults point at
# Resend's SMTP relay (smtp.resend.com:587, user "resend"); override for another provider.
# Resend API key (resend.com/api-keys). Required for email delivery.
EMAIL_HOST_PASSWORD=
# Sender address on a domain verified in Resend, e.g. "Rule Triggers <login@example.com>".
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
# Seconds to wait on the SMTP server before giving up.
EMAIL_TIMEOUT=
