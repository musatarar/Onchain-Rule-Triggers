@@ -404,6 +385,29 @@
 
 void doomgeneric_Tick()
 {
+    static boolean wiping = false;
+    static int wipestart;
+
+    // A screen wipe advances by the tics elapsed since its last step and
+    // returns in between, so a host that cannot block (a browser) keeps
+    // drawing it. The game itself waits for the wipe, as it always has.
+    if (wiping)
+    {
+        int nowtime = I_GetTime ();
+        int tics = nowtime - wipestart;
+
+        if (tics <= 0)
+            return;
+
+        wipestart = nowtime;
+        wiping = !wipe_ScreenWipe(wipe_Melt
+                                  , 0, 0, SCREENWIDTH, SCREENHEIGHT, tics);
+        I_UpdateNoBlit ();
+        M_Drawer ();                            // menu is drawn even on top of wipes
+        I_FinishUpdate ();                      // page flip or blit buffer
+        return;
+    }
+
     // frame syncronous IO operations
     I_StartFrame ();
 
