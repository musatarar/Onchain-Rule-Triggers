# Build-time switches, embedded in the bundle, so nothing here is secret.
# VITE_CONSOLE_SOURCES sends console endpoints to the real API one at a time,
# e.g. "engineStatus=http,rules=http"; any key left out stays on demo data.
# Keys: engineStatus, vocabulary, rules, matches, matchDetail, tokens, propose, backtest.
VITE_CONSOLE_SOURCES=engineStatus=http,rules=http,matches=http,matchDetail=http
